node-linker=isolated

# loops.company shared toolkit (@chiemerieokorie/trigger-kit, @chiemerieokorie/docling)
# is published to GitHub Packages. Installs need NODE_AUTH_TOKEN set to a GitHub token
# with the `read:packages` scope (locally: `export NODE_AUTH_TOKEN=$(gh auth token)`;
# in CI: a repo secret). See packages/jobs/README.md.
@chiemerieokorie:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
